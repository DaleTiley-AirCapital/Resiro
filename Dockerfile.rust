FROM node:22-alpine AS marketing
WORKDIR /site
RUN apk add --no-cache unzip
COPY attached_assets/React-Marketing-Site-master_1755526798974.zip /tmp/site.zip
RUN unzip -q /tmp/site.zip -d /tmp && cp -R /tmp/React-Marketing-Site-master/. /site
RUN corepack enable && pnpm install --no-frozen-lockfile && pnpm run build
RUN sed -i 's|</body>|<a href="/login" style="position:fixed;bottom:24px;right:24px;z-index:1000;background:#1d4ed8;color:white;padding:12px 20px;border-radius:8px;font:600 16px system-ui;text-decoration:none;box-shadow:0 4px 12px #0003">Open property dashboard</a></body>|' dist/index.html

FROM rust:1.90-bookworm AS build
WORKDIR /src
ENV CARGO_BUILD_JOBS=2
COPY rust/ .
RUN cargo test --release && cargo build --release

FROM debian:bookworm-slim
RUN apt-get update -qq && apt-get install -y --no-install-recommends ca-certificates poppler-utils tesseract-ocr tesseract-ocr-afr && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /src/target/release/resiro /app/resiro
COPY --from=marketing /site/dist /app/marketing
COPY rust/public /app/public
COPY frontend/src/assets/rezdna-logo.png /app/public/logo.png
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["/app/resiro"]
