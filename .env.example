# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/property_dna

# JWT Authentication
JWT_SECRET=your-jwt-secret-key-change-in-production

# Object Storage (Cloudflare R2)
PUBLIC_OBJECT_SEARCH_PATHS=/bucket-name/public
PRIVATE_OBJECT_DIR=/bucket-name/private
S3_ENDPOINT=https://accountid.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=property-dna-prod
S3_ACCESS_KEY_ID=your-r2-access-key
S3_SECRET_ACCESS_KEY=your-r2-secret-key

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key

# OCR Configuration
OCR_PROVIDER=tesseract

# Email Configuration
SMTP_URL=smtp://user:password@smtp.example.com:587

# Payment Configuration
PAYMENT_PROVIDER=ozow
PAYMENT_API_KEY=your-payment-api-key

# Application URLs
APP_URL=https://your-app-domain.vercel.app
API_URL=https://your-api-domain.railway.app
VITE_API_URL=https://your-api-domain.railway.app

# Billing Configuration
OWNER_MARKUP=2
OWNER_ANNUAL_FLOOR_ZAR=50

# Development Configuration
PORT=5000
NODE_ENV=development
