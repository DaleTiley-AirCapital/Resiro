FROM node:22-alpine AS frontend
WORKDIR /app
RUN apk add --no-cache unzip
COPY attached_assets/React-Marketing-Site-master_1755526798974.zip /tmp/site.zip
RUN unzip /tmp/site.zip -d /tmp && cp -R /tmp/React-Marketing-Site-master/. /app
RUN corepack enable && pnpm install --no-frozen-lockfile && pnpm run build

FROM node:22-alpine AS application
WORKDIR /app
COPY frontend/package.json ./
RUN npm install --no-audit --no-fund
COPY frontend/ ./
COPY tailwind.config.ts postcss.config.js ./
RUN sed -i 's|./client/|./|g' tailwind.config.ts
RUN sed -i '/replit-dev-banner/d' index.html
RUN npm run build -- --base /application/ --outDir /application-build

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS backend
WORKDIR /src
COPY backend/ backend/
RUN dotnet publish backend/RezDNA.API/RezDNA.API.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=backend /app/publish .
COPY --from=frontend /app/dist ./wwwroot
COPY --from=application /application-build ./wwwroot/application
RUN cp wwwroot/application/index.html wwwroot/application.html \
    && sed -i 's|</body>|<a href="/login" style="position:fixed;bottom:24px;right:24px;z-index:1000;background:#1d4ed8;color:white;padding:12px 20px;border-radius:8px;font:600 16px system-ui;text-decoration:none;box-shadow:0 4px 12px #0003">Open property dashboard</a></body>|' wwwroot/index.html
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production
EXPOSE 8080
ENTRYPOINT ["dotnet", "RezDNA.API.dll"]